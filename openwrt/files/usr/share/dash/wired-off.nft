# "Wired internet off": the wired LAN ports keep reaching the router (DHCP,
# DNS, dashboard) but nothing beyond it. Wi-Fi is not affected.
table bridge dashwired {
	set wired { type ifname; elements = { "eth0", "eth1", "eth2", "eth3" } }
	chain in {
		type filter hook input priority -5; policy accept;
		iifname @wired ether type ip ip daddr != { 192.168.50.0/24, 224.0.0.0/4, 255.255.255.255 } drop
		iifname @wired ether type ip6 ip6 daddr != { fe80::/10, ff00::/8, fd00::/8 } drop
	}
	chain out {
		type filter hook output priority -5; policy accept;
		oifname @wired ether type ip ip saddr != { 192.168.50.0/24 } drop
		oifname @wired ether type ip6 ip6 saddr != { fe80::/10, fd00::/8 } drop
	}
}
