#!/bin/sh /etc/rc.common
# Runs the dashboard watcher once a minute.
START=99
USE_PROCD=1

start_service() {
	# re-apply the wired-internet switch after a reboot
	[ -f /etc/dash/wired_off ] && { nft list table bridge dashwired >/dev/null 2>&1 || nft -f /usr/share/dash/wired-off.nft; }
	procd_open_instance
	procd_set_param command /bin/sh -c 'while true; do /usr/bin/ucode /usr/share/dash/tick.uc; sleep 55; done'
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
