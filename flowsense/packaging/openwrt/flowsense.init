#!/bin/sh /etc/rc.common
# flowsense - encrypted traffic application classifier
START=95
USE_PROCD=1

start_service() {
	local zone
	zone=$(uci -q get system.@system[0].zonename)
	procd_open_instance
	procd_set_param command /usr/bin/flowsense \
		-i "$(uci -q get flowsense.main.iface || echo br-lan)" \
		-lan "$(uci -q get flowsense.main.lan || echo 192.168.50.0/24)" \
		-router "$(uci -q get flowsense.main.router || echo 192.168.50.1)" \
		-proxy-port "$(uci -q get flowsense.main.proxy_port || echo 0)" \
		-names "$(uci -q get flowsense.main.names_file)" \
		-min-conf "$(uci -q get flowsense.main.min_conf || echo 0.55)" \
		-data /etc/flowsense -seed /usr/share/flowsense/seed.csv.gz \
		${zone:+-tz "$zone"}
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
